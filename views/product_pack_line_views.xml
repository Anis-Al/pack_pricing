<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_pack_line_tree" model="ir.ui.view">
        <field name="name">product.pack.line.pricing.tree</field>
        <field name="model">product.pack.line</field>
        <field name="inherit_id" ref="sale_product_pack.product_pack_line_tree" />
        <field name="arch" type="xml">
            <field name="sale_discount" position="after">
                <field name="cost_price" />
                <field name="sale_price" />
                <field name="subtotal_cost" sum="Cost" />
                <field name="subtotal_sale" sum="Sales Price" />
                <field name="margin" sum="Margin" />
                <field name="margin_percent" optional="show" />
            </field>
        </field>
    </record>
    <record id="product_pack_line_form" model="ir.ui.view">
        <field name="name">product.pack.line.pricing.form</field>
        <field name="model">product.pack.line</field>
        <field name="inherit_id" ref="sale_product_pack.product_pack_line_form" />
        <field name="arch" type="xml">
            <field name="sale_discount" position="after">
                <field name="cost_price" />
                <field name="sale_price" />
                <field name="subtotal_cost" />
                <field name="subtotal_sale" />
                <field name="margin" />
                <field name="margin_percent" />
            </field>
        </field>
    </record>
</odoo>
