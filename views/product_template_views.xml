<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.pack.pricing.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_pack.product_template_only_form_view" />
        <field name="arch" type="xml">
            <field name="pack_modifiable" position="after">
                <field name="pack_price_auto" />
                <field name="discount" />
            </field>
            <!-- Always non detailed: components never reach the order anyway. -->
            <field name="pack_type" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </field>
            <field name="pack_line_ids" position="after">
                <group colspan="4" col="4" invisible="not discount">
                    <!-- ponytail: cost/sale/margin totals are already summed by the
                         list above; only show what the columns can't. -->
                    <group string="Margin">
                        <label for="pack_margin" string="Before Discount" />
                        <div class="o_row">
                            <field name="pack_margin" />
                            <span class="text-muted" style="font-size: 0.7em">
                                <field name="pack_margin_percent" />%</span>
                        </div>
                        <label
                            for="pack_margin_after_discount"
                            invisible="not pack_discount"
                        />
                        <div class="o_row" invisible="not pack_discount">
                            <field name="pack_margin_after_discount" />
                            <span class="text-muted" style="font-size: 0.7em">
                                <field
                                    name="pack_margin_percent_after_discount"
                                />%</span>
                        </div>
                    </group>
                    <!-- ponytail: bootstrap alert classes are already in the backend
                         assets, no custom scss for one highlighted group. -->
                    <group string="Pack Discount" class="alert alert-info">
                        <field name="pack_price_before_discount" />
                        <field name="pack_discount" />
                        <field name="pack_price_final" />
                        <p
                            colspan="2"
                            class="text-muted"
                            invisible="not pack_price_auto"
                        >Saving publishes this discount as a pricelist item in the
                            <b>Packs</b> pricelist, and copies the totals above onto the
                            product's sales price and cost.</p>
                    </group>
                </group>
            </field>
            <xpath
                expr="//group[@name='group_standard_price']//field[@name='list_price']"
                position="attributes"
            >
                <attribute name="readonly">pack_price_auto</attribute>
            </xpath>
            <xpath
                expr="//group[@name='group_standard_price']//field[@name='standard_price']"
                position="attributes"
            >
                <attribute name="readonly">pack_price_auto</attribute>
            </xpath>
        </field>
    </record>
</odoo>
