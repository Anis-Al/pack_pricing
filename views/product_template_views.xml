<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.pack.pricing.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_pack.product_template_only_form_view" />
        <field name="arch" type="xml">
            <field name="pack_modifiable" position="after">
                <field name="pack_price_auto" />
            </field>
            <field name="pack_line_ids" position="after">
                <group colspan="4" col="4">
                    <group string="Pack Totals">
                        <field name="pack_total_cost" />
                        <field name="pack_total_sale" />
                        <field name="pack_margin" />
                        <field name="pack_margin_percent" />
                    </group>
                    <group string="Pack Discount">
                        <field name="pack_discount" />
                        <field name="pack_price_final" />
                        <p
                            colspan="2"
                            class="text-muted"
                            invisible="not pack_price_auto"
                        >Saving publishes this discount as a pricelist item in the
                            <b>Packs</b> pricelist, and copies the totals above onto the
                            product's sales price and cost.</p>
                    </group>
                </group>
            </field>
            <xpath
                expr="//group[@name='group_standard_price']//field[@name='list_price']"
                position="attributes"
            >
                <attribute name="readonly">pack_price_auto</attribute>
            </xpath>
            <xpath
                expr="//group[@name='group_standard_price']//field[@name='standard_price']"
                position="attributes"
            >
                <attribute name="readonly">pack_price_auto</attribute>
            </xpath>
        </field>
    </record>
</odoo>
